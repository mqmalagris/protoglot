{
  "name": "protoglot",
  "version": "0.1.2",
  "description": "Local-first, git-friendly multiprotocol API client (REST/GraphQL/SOAP/WebSocket/gRPC) with a CI-first CLI",
  "keywords": ["api", "http", "grpc", "graphql", "cli", "rest", "soap", "websocket"],
  "homepage": "https://github.com/mqmalagris/protoglot",
  "repository": { "type": "git", "url": "git+https://github.com/mqmalagris/protoglot.git" },
  "license": "(MIT OR Apache-2.0)",
  "bin": {
    "protoglot": "bin/protoglot.js",
    "pglot": "bin/pglot.js"
  },
  "scripts": {
    "postinstall": "node install.js"
  },
  "files": ["bin", "run.js", "install.js"],
  "os": ["darwin", "linux", "win32"],
  "cpu": ["x64", "arm64"],
  "engines": { "node": ">=18" }
}
